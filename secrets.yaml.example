# Made By FALCREB
# Bu dosyayı Home Assistant'ın /config klasörüne secrets.yaml adıyla kopyalayıp
# CHANGE_ME değerlerini doldurun. secrets.yaml asla git'e eklenmez.
# EN: copy to /config/secrets.yaml and fill in real values. Never commit it.

# Birincil (bulut) TTS servisinin anahtarı ve bölgesi
# EN: primary cloud TTS key and region
tts_primary_key: CHANGE_ME
tts_primary_region: CHANGE_ME

# tts_failover.py için ayrı bir uzun ömürlü erişim token'ı
# EN: dedicated long-lived access token for tts_failover.py
tts_failover_token: CHANGE_ME
